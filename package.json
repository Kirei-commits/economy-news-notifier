{
  "name": "economy-news-notifier",
  "version": "1.0.0",
  "description": "経済ニュースをRSSから収集し、日刊の新聞レイアウトHTML(GitHub Pages)として発行しつつDiscordに通知するアプリ",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "check-sources": "tsx src/checkSources.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
